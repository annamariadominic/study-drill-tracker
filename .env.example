# The password required to access the app.
APP_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Supabase project URL and server-side secret key (sb_secret_...).
# Never expose the secret key to the client.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic API key, used server-side only to generate and grade questions.
ANTHROPIC_API_KEY=

# Bearer token Vercel Cron sends to /api/cron/due-reminder. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# Resend API key and the addresses the daily due-reminder email goes from/to.
# REMINDER_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
REMINDER_EMAIL_FROM=
REMINDER_EMAIL_TO=
